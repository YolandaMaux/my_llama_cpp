# Absolute host directory containing GGUF/mmproj files
MODELS_DIR=/home/riaz/LLM_models/Models_GGUF/models

# Container-internal path where llamacpp_models.ini is mounted AND read
# from. Both volumes: and environment: in every compose file reference
# this SAME variable, so they can never point at different paths again.
MODELS_INI_CONTAINER_PATH=/etc/llamacpp/models.ini


# HTTP port exposed on the host
LLAMACPP_PORT=8080

# Router capacity: maximum simultaneously resident models.
# Raised from 1 -> 3 so the always-on embedder + reranker (see
# load-on-startup entries in llamacpp_models.ini) can stay loaded
# alongside one chat/vision/code model at a time.
#
# When a request needs a model and all 3 slots are full, the router
# automatically evicts the Least-Recently-Used model to make room —
# this is the built-in "auto-replace" behavior; no extra flag needed
# beyond this being > 1. Drop this to 2 if you hit VRAM OOM errors on
# the Titan X (12GB) once you're loading larger 12B/30B-MoE models
# next to the embedder/reranker.
LLAMA_ARG_MODELS_MAX=2
LLAMA_ARG_PARALLEL=1
LLAMA_ARG_CTX_SIZE=4096

# Generic NVIDIA GPU / Titan X: number of layers to offload (0 = CPU)
LLAMA_ARG_N_GPU_LAYERS=99

# Generic NVIDIA image tag. Pin this after validating a working release.
LLAMACPP_STANDARD_GPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Titan X build inputs (Maxwell SM 5.2)
CUDA_IMAGE_TAG=12.4.1
LLAMACPP_REF=master


